# Copy to .env and fill in ONE free API key. Never commit .env.

# Which LLM to use: groq | gemini
LLM_PROVIDER=groq

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

LLM_TIMEOUT_SECONDS=30
KB_TOP_K=3

# Defaults to a SQLite file (support.db) in the project root.
# DATABASE_URL=sqlite:///./support.db
